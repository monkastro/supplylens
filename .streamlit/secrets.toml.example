# Option 1 (recommended): Reuse the Snowflake CLI connection.
# This picks up the same OAuth/browser auth that the CoCo CLI uses.
# The connection name must match an entry in ~/.snowflake/connections.toml.
[snowflake]
connection_name = "your-connection-name"
warehouse = "COMPUTE_WH"

# Option 2: Explicit password authentication.
# [snowflake]
# account = "your-account-identifier"
# user = "your-username"
# password = "your-password-here"
# warehouse = "COMPUTE_WH"
# role = "ACCOUNTADMIN"
